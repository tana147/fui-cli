                      "type": "number",
                      ":required": true
                    }
                  },
                  {
                    "el": "v-select",
                    "w": 6,
                    "attr": {
                      "v-model": "Khoi",
                      "label": "Khối",
                      ":items": "vueData.khoiOptions",
                      "item-title": "text",
                      "item-value": "value",
                      ":required": true
                    }
                  },
                  {
                    "el": "v-select",
                    "w": 4,
                    "attr": {
                      "v-model": "Thu",
                      "label": "Thứ",
                      ":items": [
                        {
                          "text": "Thứ 2",
                          "value": 2
                        },
                        {
                          "text": "Thứ 3",
                          "value": 3
                        },
                        {
                          "text": "Thứ 4",
                          "value": 4
                        },
                        {
                          "text": "Thứ 5",
                          "value": 5
                        },
                        {
                          "text": "Thứ 6",
                          "value": 6
                        },
                        {
                          "text": "Thứ 7",
                          "value": 7
                        }
                      ],
                      "item-title": "text",
                      "item-value": "value"
                    }
                  },
                  {
                    "el": "v-select",
                    "w": 4,
                    "attr": {
                      "v-model": "Buoi",
                      "label": "Buổi",
                      ":items": [
                        {
                          "text": "Sáng",
                          "value": "Sang"
                        },
                        {
                          "text": "Chiều",
                          "value": "Chieu"
                        }
                      ],
                      "item-title": "text",
                      "item-value": "value"
                    }
                  },
                  {
                    "el": "v-text-field",
                    "w": 4,
                    "attr": {
                      "v-model.number": "Tiet",
                      "label": "Tiết",
                      "type": "number"
                    }
                  },
                  {
                    "el": "v-text-field",
                    "w": 12,
                    "attr": {
                      "v-model": "GhiChu",
                      "label": "Ghi chú"
                    }
                  }
                ],
                ":update-api": {
                  "default-item": {
                    "Tuan": null,
                    "Khoi": "",
                    "Thu": 2,
                    "Buoi": "Sang",
                    "Tiet": 1,
                    "GhiChu": ""
                  },
                  "new": {
                    "API": "/TkbChaoCoKhoiTuanInsert",
                    "IN": {
                      "Tuan": "item.Tuan",
                      "Khoi": "item.Khoi",
                      "Thu": "item.Thu",
                      "Buoi": "item.Buoi",
                      "Tiet": "item.Tiet",
                      "GhiChu": "item.GhiChu"
                    },
                    "CALLBACK": [
                      {
                        "MESS": "Thêm thành công"
                      },
                      {
                        "CALL": "fetchChaoCoTuan"
                      }
                    ]
                  },
                  "edit": {
                    "API": "/TkbChaoCoKhoiTuanUpdate",
                    "IN": {
                      "ID": "item.ID",
                      "Tuan": "item.Tuan",
                      "Khoi": "item.Khoi",
                      "Thu": "item.Thu",
                      "Buoi": "item.Buoi",
                      "Tiet": "item.Tiet",
                      "GhiChu": "item.GhiChu"
                    },
                    "CALLBACK": [
                      {
                        "MESS": "Cập nhật thành công"
                      },
                      {
                        "CALL": "fetchChaoCoTuan"
                      }
                    ]
                  },
                  "delete": {
                    "CONFIRM": "Bạn có chắc muốn xoá ngoại lệ tuần này?",
                    "API": "/TkbChaoCoKhoiTuanDelete",
                    "IN": {
                      "ID": "item.ID"
                    },
                    "CALLBACK": [
                      {
                        "MESS": "Đã xoá"
                      },
                      {
                        "CALL": "fetchChaoCoTuan"
                      }
                    ]
                  }
                }
              },
              "w": 12
            }
