    },
    {
      "fetchChaoCo": {
        "API": "/TkbChaoCoKhoiList",
        "OUT": "dsChaoCo",
        "CALLBACK": [
          {
            "EXE": "vueData.dsChaoCoGrid = vueData.dsChaoCo.map(function(r){ return Object.assign({}, r, {MaMon: 'Khối ' + r.Khoi}); })"
          }
        ]
      }
    },
    {
      "insertChaoCo": {
        "API": "/TkbChaoCoKhoiInsert",
        "IN": {
          "Khoi": "vueData.form.Khoi",
          "Thu": "vueData.form.Thu",
          "Buoi": "vueData.form.Buoi",
          "Tiet": "vueData.form.Tiet",
          "GhiChu": "vueData.form.GhiChu"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Thêm thành công"
          },
          {
            "CALL": "fetchChaoCo"
          }
        ]
      }
    },
    {
      "updateChaoCo": {
        "API": "/TkbChaoCoKhoiUpdate",
        "IN": {
          "ID": "vueData.form.ID",
          "Khoi": "vueData.form.Khoi",
          "Thu": "vueData.form.Thu",
          "Buoi": "vueData.form.Buoi",
          "Tiet": "vueData.form.Tiet",
          "GhiChu": "vueData.form.GhiChu"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Cập nhật thành công"
          },
          {
            "CALL": "fetchChaoCo"
          }
        ]
      }
    },
    {
      "saveChaoCo": {
        "IF": "vueData.addNew == 1",
        "THEN": {
          "CALL": "insertChaoCo"
        },
        "ELSE": {
          "CALL": "updateChaoCo"
        }
      }
    },
    {
      "moveChaoCo": {
        "API": "/TkbChaoCoKhoiUpdate",
        "IN": {
          "ID": "vueData.moveItem.ID",
          "Khoi": "vueData.moveItem.Khoi",
          "Thu": "vueData.moveItem.Thu",
          "Buoi": "vueData.moveItem.Buoi",
          "Tiet": "vueData.moveItem.Tiet",
          "GhiChu": "vueData.moveItem.GhiChu"
        },
        "CALLBACK": [
          {
            "MESS": "Đã dời lịch chào cờ"
          },
          {
            "CALL": "fetchChaoCo"
          }
        ]
      }
    },
    {
      "moveItem": {
        "ID": null,
        "Khoi": "",
        "Thu": 2,
        "Buoi": "Sang",
        "Tiet": 1,
        "GhiChu": ""
      },
      "moveTrigger": 0
    },
    {
      "fetchChaoCoTuan": {
        "API": "/TkbChaoCoKhoiTuanList",
        "OUT": "dsChaoCoTuan",
        "CALLBACK": [
          {
            "EXE": "vueData.dsChaoCoTuan = vueData.dsChaoCoTuan.map(function(r){ return Object.assign({}, r, {ThuText: 'Thứ ' + r.Thu, BuoiText: r.Buoi === 'Sang' ? 'Sáng' : 'Chiều'}); })"
          }
        ]
      }
    },
    {
      "CALL": "fetchChaoCo"
    },
    {
      "CALL": "fetchChaoCoTuan"
    }
  ],
  "watch": {
    "moveTrigger": {
      "CALL": "moveChaoCo"
    }
  },
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "row",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "text-body-2 grey--text text--darken-1 my-2"
              },
              "innerHTML": "Khung giờ chào cờ cố định của từng khối — solver sẽ tự tránh xếp môn học khác vào đúng khung giờ này khi chạy Auto (không cần khóa tay). Bấm ô trống để thêm, bấm bút để sửa, hoặc kéo-thả 1 ô đã có sang ô trống để dời giờ.",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "uc-tkb-grid",
              "attr": {
                ":items": "vueData.dsChaoCoGrid",
                ":editable": true,
                ":addable": true,
                ":draggable": true,
                ":fixed-thu-cols": "vueData.fixedThuCols",
                ":fixed-slots": "vueData.fixedSlots",
                "sub-label-field": "GhiChu",
                "v-on:edit-cell": "vueData.addNew = 0, vueData.form = {ID: $event.ID, Khoi: $event.Khoi, Thu: $event.Thu, Buoi: $event.Buoi, Tiet: $event.Tiet, GhiChu: $event.GhiChu}, vueData.dlForm = true",
                "v-on:add-cell": "vueData.addNew = 1, vueData.form = {ID: null, Khoi: '', Thu: $event.Thu, Buoi: $event.Buoi, Tiet: $event.Tiet, GhiChu: ''}, vueData.dlForm = true",
                "v-on:move-cell": "vueData.moveItem = {ID: $event.item.ID, Khoi: $event.item.Khoi, Thu: $event.Thu, Buoi: $event.Buoi, Tiet: $event.Tiet, GhiChu: $event.item.GhiChu}, vueData.moveTrigger = vueData.moveTrigger + 1"
              },
              "w": 12
            }
          ]
        },
