        {
          "prop": "row",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "text-body-2 grey--text text--darken-1 mt-6 mb-2"
              },
              "innerHTML": "Ngoại lệ theo tuần — khi 1 tuần cụ thể có lịch sinh hoạt/chào cờ KHÁC với khung giờ cố định ở trên (vd đổi buổi, đổi tiết), thêm 1 dòng riêng cho đúng khối + đúng tuần đó tại đây. Solver sẽ ưu tiên dùng dòng này thay cho khung giờ cố định khi chạy Auto đúng tuần đó.",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                ":items": "vueData.dsChaoCoTuan",
                "item-key": "ID",
                ":items-per-page": -1,
                ":hide-default-footer": true,
                ":height": 300,
                ":headers": [
                  {
                    "text": "Tuần",
                    "value": "Tuan",
                    "align": "center",
                    "width": "80px"
                  },
                  {
                    "text": "Khối",
                    "value": "Khoi",
                    "align": "center",
                    "width": "80px"
                  },
                  {
                    "text": "Thứ",
                    "value": "ThuText",
                    "align": "center",
                    "width": "80px"
                  },
                  {
                    "text": "Buổi",
                    "value": "BuoiText",
                    "align": "center",
                    "width": "90px"
                  },
                  {
                    "text": "Tiết",
                    "value": "Tiet",
                    "align": "center",
                    "width": "70px"
                  },
                  {
                    "text": "Ghi chú",
                    "value": "GhiChu"
                  },
                  {
                    "text": "Sửa",
                    "value": "ctrl-update",
                    "align": "center",
                    "width": "90px"
                  }
                ],
                ":update-form": [
                  {
                    "el": "v-text-field",
                    "w": 6,
                    "attr": {
                      "v-model.number": "Tuan",
