                  },
                  {
                    "text": "Tiết",
                    "value": "TietText",
                    "align": "center",
                    "width": "80px"
                  },
                  {
                    "text": "Lý do",
                    "value": "LyDo",
                    "width": "120px"
                  },
                  {
                    "text": "Xoá",
                    "value": "ctrl-update",
                    "align": "center",
                    "width": "70px"
                  }
                ],
                ":update-api": {
                  "delete": {
                    "CONFIRM": "Bạn có chắc muốn xoá lịch bận này?",
                    "API": "/TkbGVCamTuyetDoiTuanDelete",
                    "IN": {
                      "ID": "item.ID"
                    },
                    "CALLBACK": [
                      {
                        "MESS": "Đã xoá"
                      },
                      {
                        "CALL": "fetchGVLich"
                      }
                    ]
                  }
                }
              },
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "v-divider",
              "attr": {
                "class": "my-3"
              },
              "w": 12
            },
            {
              "el": "div",
              "attr": {
                "class": "text-subtitle-1 font-weight-medium"
              },
              "innerHTML": "Vùng dự phòng (chỉ dùng khi kẹt, không dùng nếu còn cách khác)",
              "w": 12
            },
            {
              "el": "div",
              "attr": {
                "class": "text-body-2 grey--text text--darken-1 mb-2"
              },
              "innerHTML": "Chỉ khai khi CÓ THẬT — ví dụ GV thỉnh giảng chỉ nhận Sáng T2, T4 nhưng vẫn có thể dạy thêm Chiều T3 nếu bắt buộc. Solver sẽ ưu tiên dùng hết giờ đã khai ở trên (Rảnh), chỉ đụng vào ô dự phòng này khi không còn cách nào khác, và phạt điểm cao trong lời giải để hạn chế lạm dụng. Khai sai (GV thực tế không dạy được) sẽ tạo ra lịch nhìn đủ nhưng không đúng thực tế — chỉ nhập khi chắc chắn.",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "v-spacer",
              "w": 10
            },
            {
              "el": "f-button",
              "attr": {
                "label": "Thêm vùng dự phòng",
                "icon-text": "mdi-shield-plus-outline",
                "variant": "outlined",
                "color": "warning",
                ":checkvalid": false,
                "v-on:click": "vueData.formBackup = {MaGV: vueData.filterMaGV || '', TuanTu: vueData.filterTuanTu, TuanDen: vueData.filterTuanDen, Thu: 2, Buoi: 'Chieu', Tiet: null, Phat: 1500, LyDo: ''}, vueData.dlBackupForm = true"
              },
              "w": 2
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                ":items": "vueData.dsBackupSlot",
                "item-key": "ID",
