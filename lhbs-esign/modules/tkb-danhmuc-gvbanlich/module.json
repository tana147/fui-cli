            {
              "el": "v-spacer",
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "label": "Thêm lịch bận",
                "icon-text": "mdi-plus",
                ":checkvalid": false,
                "v-on:click": "vueData.form = {MaGV: vueData.filterMaGV || '', TuanTu: vueData.filterTuanTu, TuanDen: vueData.filterTuanDen, Thu: 2, Buoi: '', Tiet: null, LyDo: 'Bận'}, vueData.dlForm = true"
              },
              "w": 2
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "text-subtitle-1 font-weight-medium mt-2"
              },
              "innerHTML": "Xem dạng lưới (chọn GV ở trên + 1 tuần cụ thể)",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "v-select",
              "attr": {
                "v-model": "vueData.gridTuan",
                "label": "Tuần xem lưới",
                ":items": "vueData.tuanOptions",
                "item-title": "TenTuan",
                "item-value": "TuanTrongNam",
                ":clearable": true,
                "v-on:update:model-value": "vueData.filterMaGV ? CALL(vueData.fetchGridData) : null"
              },
              "w": 4
            },
            {
              "el": "f-button",
              "attr": {
                "label": "Xem lưới",
                "icon-text": "mdi-table",
                ":checkvalid": false,
                ":disabled": "!vueData.filterMaGV || !vueData.gridTuan",
                "action": {
                  "CALL": "fetchGridData"
                }
              },
              "w": 2
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "uc-tkb-grid",
              "attr": {
                "v-if": "vueData.filterMaGV && vueData.gridTuan",
                ":items": "vueData.dsGridItems",
                ":editable": true,
                ":addable": true,
                ":fixed-thu-cols": "vueData.fixedThuCols",
                ":fixed-slots": "vueData.fixedSlots",
                "sub-label-field": "TenGV",
                "v-on:edit-cell": "vueData.xoaLuoiID = $event.ID, CALL(vueData.xoaTuLuoi)",
                "v-on:add-cell": "vueData.form = {MaGV: vueData.filterMaGV, TuanTu: vueData.gridTuan, TuanDen: vueData.gridTuan, Thu: $event.Thu, Buoi: $event.Buoi, Tiet: $event.Tiet, LyDo: 'Bận'}, vueData.dlForm = true"
              },
              "w": 12
            },
            {
              "el": "div",
              "attr": {
                "v-if": "!(vueData.filterMaGV && vueData.gridTuan)",
                "class": "text-caption grey--text pa-4"
              },
              "innerHTML": "Chọn GV (ở ô lọc phía trên) và 1 Tuần để xem lưới",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                ":items": "vueData.dsGVLich",
                "item-key": "ID",
                ":height": -16,
                ":headers": [
                  {
                    "text": "Tuần",
                    "value": "Tuan",
