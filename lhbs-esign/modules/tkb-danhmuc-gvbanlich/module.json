          "value": 7
        }
      ]
    },
    {
      "fetchGV": {
        "API": "/TkbGiaoVienList",
        "IN": {
          "Keyword": "",
          "ChiThinhGiang": 0
        },
        "OUT": "dsGVOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsGVOptions = vueData.dsGVOptions.map(function(r){ return {text: r.HoTen + ' (' + r.MaGV + ')' + (r.LaThinhGiang ? ' - Thỉnh giảng' : ''), value: r.MaGV, laThinhGiang: !!r.LaThinhGiang}; })"
          }
        ]
      }
    },
    {
      "fetchGVLich": {
        "API": "/TkbGVCamTuyetDoiTuanList",
        "IN": {
          "MaGV": "vueData.filterMaGV",
          "TuanTu": "vueData.filterTuanTu",
          "TuanDen": "vueData.filterTuanDen"
        },
        "OUT": "dsGVLich",
        "CALLBACK": [
          {
            "EXE": "vueData.dsGVLich = vueData.dsGVLich.map(function(r){ return Object.assign({}, r, {ThuText: 'Thứ ' + r.Thu, BuoiText: r.Buoi === 'Sang' ? 'Sáng' : (r.Buoi === 'Chieu' ? 'Chiều' : 'Cả ngày'), TietText: r.Tiet == null ? 'Cả buổi' : r.Tiet}); })"
          }
        ]
      }
    },
    {
      "insertGVLich": {
        "API": "/TkbGVCamTuyetDoiTuanInsert",
        "IN": {
          "MaGV": "vueData.form.MaGV",
          "TuanTu": "vueData.form.TuanTu",
          "TuanDen": "vueData.form.TuanDen",
          "Thu": "vueData.form.Thu",
          "Buoi": "vueData.form.Buoi",
          "Tiet": "vueData.form.Tiet",
          "LyDo": "vueData.form.LyDo"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Đã lưu"
          },
          {
            "CALL": "fetchGVLich"
          }
        ]
      }
    },
    {
      "khoiTaoThinhGiang": {
        "API": "/TkbGVCamTuyetDoiTuanKhoiTaoThinhGiang",
        "IN": {
          "MaGV": "vueData.form.MaGV",
          "TuanTu": "vueData.form.TuanTu",
          "TuanDen": "vueData.form.TuanDen"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Đã khởi tạo lịch bận mặc định — vào xoá bớt đúng giờ GV rảnh"
          },
          {
            "CALL": "fetchGVLich"
          }
        ]
      }
    },
    {
      "fetchTuanOptions": {
        "API": "/TkbTuanList",
        "IN": {
          "NamHoc": ""
        },
        "OUT": "tuanOptions"
      }
    },
    {
      "fetchGridData": {
        "API": "/TkbGVCamTuyetDoiTuanList",
        "IN": {
          "MaGV": "vueData.filterMaGV",
          "TuanTu": "vueData.gridTuan",
          "TuanDen": "vueData.gridTuan"
        },
        "OUT": "dsGridRaw",
        "CALLBACK": [
          {
            "EXE": "vueData.dsGridItems = []; vueData.dsGridRaw.forEach(function(r){ var buois = r.Buoi ? [r.Buoi] : ['Sang','Chieu']; buois.forEach(function(b){ var maxTiet = b === 'Sang' ? 5 : 4; var tiets = (r.Tiet != null) ? [r.Tiet] : Array.from({length: maxTiet}, function(_, i){ return i + 1; }); tiets.forEach(function(t){ vueData.dsGridItems.push({ID: r.ID, Thu: r.Thu, Buoi: b, Tiet: t, MaMon: r.LyDo, TenGV: r.LyDo, DaKhoa: false}); }); }); });"
          }
        ]
      }
    },
    {
      "xoaTuLuoi": {
        "CONFIRM": "Xoá lịch bận này?",
        "API": "/TkbGVCamTuyetDoiTuanDelete",
        "IN": {
          "ID": "vueData.xoaLuoiID"
        },
        "CALLBACK": [
          {
            "MESS": "Đã xoá"
          },
          {
            "CALL": "fetchGridData"
          },
          {
            "CALL": "fetchGVLich"
          }
        ]
      }
    },
    {
      "dsBackupSlot": [],
      "insertBackupResp": {},
      "dlBackupForm": false,
      "formBackup": {
        "MaGV": "",
        "TuanTu": null,
        "TuanDen": null,
        "Thu": 2,
        "Buoi": "Chieu",
        "Tiet": null,
        "Phat": 1500,
        "LyDo": ""
      }
    },
    {
      "fetchBackupSlot": {
        "API": "/TkbGVBackupSlotTuanList",
        "IN": {
          "MaGV": "vueData.filterMaGV",
          "TuanTu": "vueData.filterTuanTu",
          "TuanDen": "vueData.filterTuanDen"
        },
        "OUT": "dsBackupSlot",
        "CALLBACK": [
          {
            "EXE": "vueData.dsBackupSlot = vueData.dsBackupSlot.map(function(r){ return Object.assign({}, r, {ThuText: 'Thứ ' + r.Thu, BuoiText: r.Buoi === 'Sang' ? 'Sáng' : 'Chiều'}); })"
          }
        ]
      }
    },
    {
      "insertBackupSlot": {
        "API": "/TkbGVBackupSlotTuanInsert",
        "IN": {
          "MaGV": "vueData.formBackup.MaGV",
          "TuanTu": "vueData.formBackup.TuanTu",
          "TuanDen": "vueData.formBackup.TuanDen",
          "Thu": "vueData.formBackup.Thu",
          "Buoi": "vueData.formBackup.Buoi",
          "Tiet": "vueData.formBackup.Tiet",
          "Phat": "vueData.formBackup.Phat",
          "LyDo": "vueData.formBackup.LyDo"
        },
        "OUT": "insertBackupResp",
        "CALLBACK": [
          {
            "MESS": "{{vueData.insertBackupResp.mess}}"
          },
          {
            "IF": "vueData.insertBackupResp && vueData.insertBackupResp.success",
            "THEN": [
              {
                "EXE": "vueData.dlBackupForm = false"
              },
              {
                "CALL": "fetchBackupSlot"
              }
            ]
          }
        ]
      }
    },
    {
      "CALL": "fetchGV"
    },
    {
      "CALL": "fetchGVLich"
    },
    {
      "CALL": "fetchTuanOptions"
    },
    {
      "CALL": "fetchBackupSlot"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "row",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "text-body-2 grey--text text--darken-1 my-2"
              },
              "innerHTML": "Khai báo giờ BẬN/HỌP/công tác của GV (kể cả GV thỉnh giảng) — mặc định GV được coi là RẢNH mọi giờ, chỉ cần khai đúng giờ KHÔNG THỂ xếp lịch tại đây. Solver sẽ tự tránh xếp bất kỳ môn nào vào đúng giờ đã khai cho GV đó, đúng tuần đó.",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "v-autocomplete",
              "attr": {
                "v-model": "vueData.filterMaGV",
                "label": "Lọc theo GV (gõ để tìm tên)",
                ":items": "vueData.dsGVOptions",
                "item-title": "text",
                "item-value": "value",
                ":clearable": true,
                "v-on:update:model-value": "CALL(vueData.fetchGVLich), (vueData.gridTuan ? CALL(vueData.fetchGridData) : null)"
              },
              "w": 4
            },
            {
              "el": "v-text-field",
              "attr": {
                "v-model.number": "vueData.filterTuanTu",
                "label": "Từ tuần",
                "type": "number",
                ":clearable": true,
                "v-on:change": "CALL(vueData.fetchGVLich)"
              },
              "w": 2
            },
            {
              "el": "v-text-field",
              "attr": {
                "v-model.number": "vueData.filterTuanDen",
                "label": "Đến tuần",
                "type": "number",
                ":clearable": true,
                "v-on:change": "CALL(vueData.fetchGVLich)"
