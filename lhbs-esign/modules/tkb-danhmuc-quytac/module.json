    {
      "menuHanhDong": [
        {
          "color": "primary",
          "icon-text": "mdi-pencil",
          "text": "Sửa",
          "action": [
            {
              "addNew": 0,
              "form": {
                "ID": "item.ID",
                "MaMon": "item.MaMon",
                "Khoi": "item.Khoi",
                "LoaiQuyTac": "item.LoaiQuyTac",
                "ThamSo": "item.ThamSo",
                "GhiChu": "item.GhiChu",
                "Enable": "item.Enable"
              }
            },
            {
              "dlForm": true
            }
          ]
        },
        {
          "color": "warning",
          "icon-text": "mdi-delete",
          "text": "Xóa",
          "action": {
            "CONFIRM": "Bạn có chắc muốn xoá quy tắc này?",
            "API": "/TkbMonQuyTacDelete/`{{item.ID}}",
            "CALLBACK": [
              {
                "MESS": "Đã xoá"
              },
              {
                "CALL": "fetchQuyTac"
              }
            ]
          }
        }
      ]
    },
    {
      "fetchQuyTac": {
        "API": "/TkbMonQuyTacList",
        "IN": {
          "Keyword": "vueData.filterKeyword"
        },
        "OUT": "dsQuyTac"
      }
    },
    {
      "insertQuyTac": {
        "API": "/TkbMonQuyTacInsert",
        "IN": {
          "MaMon": "vueData.form.MaMon",
          "Khoi": "vueData.form.Khoi",
          "LoaiQuyTac": "vueData.form.LoaiQuyTac",
          "ThamSo": "vueData.form.ThamSo",
          "GhiChu": "vueData.form.GhiChu"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Thêm thành công"
          },
          {
            "CALL": "fetchQuyTac"
          }
        ]
      }
    },
    {
      "updateQuyTac": {
        "API": "/TkbMonQuyTacUpdate",
        "IN": {
          "ID": "vueData.form.ID",
          "MaMon": "vueData.form.MaMon",
          "Khoi": "vueData.form.Khoi",
          "LoaiQuyTac": "vueData.form.LoaiQuyTac",
          "ThamSo": "vueData.form.ThamSo",
          "GhiChu": "vueData.form.GhiChu",
          "Enable": "vueData.form.Enable"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Cập nhật thành công"
          },
          {
            "CALL": "fetchQuyTac"
          }
        ]
      }
    },
    {
      "saveQuyTac": {
        "IF": "vueData.addNew == 1",
        "THEN": {
          "CALL": "insertQuyTac"
        },
        "ELSE": {
          "CALL": "updateQuyTac"
        }
      }
    },
    {
      "CALL": "fetchQuyTac"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "row",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "text-body-2 grey--text text--darken-1 my-2"
              },
              "innerHTML": "Cấu hình các luật xếp lịch tổng quát hóa được (áp dụng theo Môn, tùy chọn theo Khối) — solver đọc bảng này để quyết định áp dụng luật cho môn nào, không cần sửa code. Khối để trống = áp dụng mọi khối.",
              "w": 12
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "v-text-field",
              "col": {
                "class": "shrink"
              },
              "attr": {
                "class": "flex-md-grow-0 my-2",
                "v-model": "vueData.filterKeyword",
                "label": "Tìm mã môn / loại quy tắc",
                ":required": false
              },
              "w": "280"
            },
            {
              "el": "v-spacer",
              "attr": {},
              "w": ""
            },
            {
              "el": "f-button",
              "col": {
                "class": "shrink"
              },
              "attr": {
                "class": "my-2",
                "label": "Thêm quy tắc",
                "icon-text": "mdi-plus",
                ":checkvalid": false,
                "action": [
                  {
                    "addNew": 1,
                    "form": {
                      "ID": null,
                      "MaMon": "",
                      "Khoi": "",
                      "LoaiQuyTac": "",
                      "ThamSo": "{}",
                      "GhiChu": "",
                      "Enable": true
                    }
                  },
                  {
                    "dlForm": true
                  }
                ]
              },
              "w": ""
            }
          ]
        },
        {
          "prop": "row",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Danh mục quy tắc",
                ":items": "vueData.dsQuyTac",
                "item-key": "ID",
                ":items-per-page": -1,
                ":hide-default-footer": true,
                ":height": -16,
                ":headers": [
                  {
                    "align": "center",
                    "title": "Mã môn",
                    "value": "MaMon",
                    "width": "90px"
                  },
                  {
                    "title": "Tên môn",
                    "value": "TenMon"
                  },
                  {
                    "align": "center",
                    "title": "Khối",
                    "value": "Khoi",
                    "width": "80px"
                  },
                  {
                    "title": "Loại quy tắc",
                    "value": "LoaiQuyTac"
                  },
                  {
                    "title": "Tham số",
                    "value": "ThamSo"
                  },
                  {
                    "title": "Ghi chú",
                    "value": "GhiChu"
                  },
                  {
                    "el": "v-icon",
                    "align": "center",
                    "title": "Bật",
                    "value": "Enable",
                    "width": "70px"
                  },
                  {
                    "el": "t-menu",
                    "title": "Tác vụ",
                    "value": "Actions",
                    "width": "100px",
                    "align": "center",
                    "attr": {
                      ":items": "vueData.menuHanhDong"
                    }
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    },
    {
