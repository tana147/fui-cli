    {
      "fetchPhien": {
        "API": "/TkbPhienDangXayList",
        "OUT": "dsPhien"
      }
    },
    {
      "taoPhienMoi": {
        "API": "/TkbPhienMoi",
        "IN": {
          "Khoi": "vueData.formPhienMoi.Khoi",
          "GhiChu": "vueData.formPhienMoi.GhiChu"
        },
        "OUT": "phienMoiResp",
        "CALLBACK": [
          {
            "EXE": "vueData.selectedRunID = vueData.phienMoiResp[0].RunID"
          },
          {
            "EXE": "vueData.dlPhienMoi = false"
          },
          {
            "MESS": "Đã tạo phiên TKB mới"
          },
          {
            "CALL": "fetchPhien"
          }
        ]
      }
    },
    {
      "apDungKhoaPhong": {
        "API": "/TkbKhoaPhongDungChungApDung",
        "IN": {
          "RunID": "vueData.selectedRunID"
        },
        "OUT": "respKhoaPhong",
        "CALLBACK": [
          {
            "EXE": "vueData.khoaPhongMsg = 'Đã chèn ' + vueData.respKhoaPhong[0].SoLuongChen + ' dòng khóa phòng dùng chung vào phiên.'"
          },
          {
            "CALL": "fetchPhien"
          }
        ]
      }
    },
    {
      "apDungLichHop": {
        "API": "/TkbLichHopCoDinhApDung",
        "IN": {
          "RunID": "vueData.selectedRunID"
        },
        "OUT": "respLichHop",
        "CALLBACK": [
          {
            "EXE": "vueData.lichHopMsg = 'Đã chèn ' + vueData.respLichHop[0].SoLuongChen + ' dòng lịch họp vào phiên.'"
          },
          {
            "CALL": "fetchPhien"
          }
        ]
      }
    },
    {
      "fetchLopOptions": {
        "API": "/TkbLopList",
        "IN": {
          "Khoi": "",
          "Keyword": ""
        },
        "OUT": "dsLopOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsLopOptions = vueData.dsLopOptions.map(l => ({...l, LopDisplay: l.MaLop + ' (Khối ' + l.Khoi + ')'}))"
          }
        ]
      }
    },
    {
      "fetchGVOptions": {
        "API": "/TkbGiaoVienList",
        "IN": {
          "Keyword": "",
          "ChiThinhGiang": false
        },
        "OUT": "dsGVOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsGVOptions = vueData.dsGVOptions.map(g => ({...g, GVDisplay: g.MaGV + ' - ' + g.HoTen}))"
          }
        ]
      }
    },
    {
      "fetchMonOptions": {
        "API": "/TkbMonHocList",
        "IN": {
          "Keyword": ""
        },
        "OUT": "dsMonOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsMonOptions = vueData.dsMonOptions.map(m => ({...m, MonDisplay: m.MaMon + ' - ' + m.TenMon}))"
          }
        ]
      }
    },
    {
      "fetchPhongOptions": {
        "API": "/TkbPhongHocList",
        "IN": {
          "Keyword": ""
        },
        "OUT": "dsPhongOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsPhongOptions = vueData.dsPhongOptions.map(p => ({...p, PhongDisplay: p.MaPhong + ' - ' + p.TenPhong}))"
          }
        ]
      }
    },
    {
      "xepTay": {
        "API": "/TkbKetQuaXepChenKhoa",
        "IN": {
          "RunID": "vueData.selectedRunID",
          "MaLop": "vueData.formXepTay.MaLop",
          "Thu": "vueData.formXepTay.Thu",
          "Buoi": "vueData.formXepTay.Buoi",
          "Tiet": "vueData.formXepTay.Tiet",
          "MaMon": "vueData.formXepTay.MaMon",
          "MaGV": "vueData.formXepTay.MaGV",
          "MaPhong": "vueData.formXepTay.MaPhong"
        },
        "OUT": "respXepTay",
        "CALLBACK": [
          {
            "IF": "vueData.respXepTay[0].Success",
            "THEN": [
              {
                "EXE": "vueData.dlXepTay = false"
              },
              {
                "MESS": "Đã xếp tay vào phiên"
              },
              {
                "CALL": "fetchPhien"
              }
            ],
            "ELSE": {
              "EXE": "vueData.xepTayErrMsg = vueData.respXepTay[0].Message"
            }
          }
        ]
      }
    },
    {
      "CALL": "fetchPhien"
    },
    {
      "CALL": "fetchLopOptions"
    },
    {
      "CALL": "fetchGVOptions"
    },
    {
      "CALL": "fetchMonOptions"
    },
    {
      "CALL": "fetchPhongOptions"
    }
  ],
