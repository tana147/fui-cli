    {
      "xoaPhanCong": {
        "API": "/TkbPhanCongDelete/`{{vueData.xoaItem.PhanCongID}}",
        "CALLBACK": [
          {
            "EXE": "vueData.dlXoaConfirm = false"
          },
          {
            "MESS": "Đã xoá"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "fetchXemMon": {
        "API": "/TkbPhanCongList",
        "IN": {
          "Khoi": "",
          "Keyword": "",
          "HocKy": "",
          "MaMon": "vueData.xemMonMa",
          "MaGV": ""
        },
        "OUT": "dsXemMon"
      }
    },
    {
      "fetchXemGV": {
        "API": "/TkbPhanCongList",
        "IN": {
          "Khoi": "",
          "Keyword": "",
          "HocKy": "",
          "MaMon": "",
          "MaGV": "vueData.xemGVMa"
        },
        "OUT": "dsXemGV"
      }
    },
    {
      "fetchPhanCong": {
        "API": "/TkbPhanCongList",
        "IN": {
          "Khoi": "vueData.filterKhoi",
          "Keyword": "vueData.filterKeyword",
          "HocKy": "vueData.filterHocKy"
        },
        "OUT": "dsPhanCong",
        "CALLBACK": [
          {
            "EXE": "vueData.dsPhanCong = vueData.dsPhanCong.map(function(r){ var parts=[]; if(r.TuanApDungTu||r.TuanApDungDen) parts.push('Tuần ' + (r.TuanApDungTu||'?') + '-' + (r.TuanApDungDen||'?')); if(r.ApDungTuanChan===true) parts.push('Chẵn'); if(r.ApDungTuanChan===false) parts.push('Lẻ'); return Object.assign({}, r, {TuanApDungDisplay: parts.length ? parts.join(', ') : ''}); })"
          }
        ]
      }
    },
    {
      "fetchGVOptions": {
        "API": "/TkbGiaoVienList",
        "IN": {
          "Keyword": "",
          "ChiThinhGiang": false
        },
        "OUT": "dsGVOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsGVOptions = vueData.dsGVOptions.map(g => ({...g, GVDisplay: g.MaGV + ' - ' + g.HoTen + (g.GhiChu ? ' (' + g.GhiChu.replace('To:','Tổ:') + ')' : '')}))"
          }
        ]
      }
    },
    {
      "fetchLopOptions": {
        "API": "/TkbLopList",
        "IN": {
          "Khoi": "",
          "Keyword": ""
        },
        "OUT": "dsLopOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsLopOptions = vueData.dsLopOptions.map(l => ({...l, LopDisplay: l.MaLop + ' (Khối ' + l.Khoi + ')'}))"
          }
        ]
      }
    },
    {
      "fetchMonOptions": {
        "API": "/TkbMonHocList",
        "IN": {
          "Keyword": ""
        },
        "OUT": "dsMonOptions",
        "CALLBACK": [
          {
            "EXE": "vueData.dsMonOptions = vueData.dsMonOptions.map(m => ({...m, MonDisplay: m.MaMon + ' - ' + m.TenMon}))"
          }
        ]
      }
    },
    {
      "fetchOptions": [
        {
          "CALL": "fetchGVOptions"
        },
        {
          "CALL": "fetchLopOptions"
        },
        {
          "CALL": "fetchMonOptions"
        }
      ]
    },
    {
      "insertPhanCong": {
        "API": "/TkbPhanCongInsert",
        "IN": {
          "MaGV": "vueData.form.MaGV",
          "MaLop": "vueData.form.MaLop",
          "MaMon": "vueData.form.MaMon",
          "SoTietChuanTuan": "vueData.form.SoTietChuanTuan",
          "HocKy": "vueData.form.HocKy",
          "TuanApDungTu": "vueData.form.TuanApDungTu",
          "TuanApDungDen": "vueData.form.TuanApDungDen",
          "ApDungTuanChan": "vueData.form.ApDungTuanChan"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Thêm thành công"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "updatePhanCong": {
        "API": "/TkbPhanCongUpdate",
        "IN": {
          "PhanCongID": "vueData.form.PhanCongID",
          "MaGV": "vueData.form.MaGV",
          "MaLop": "vueData.form.MaLop",
          "MaMon": "vueData.form.MaMon",
          "SoTietChuanTuan": "vueData.form.SoTietChuanTuan",
          "HocKy": "vueData.form.HocKy",
          "TuanApDungTu": "vueData.form.TuanApDungTu",
          "TuanApDungDen": "vueData.form.TuanApDungDen",
          "ApDungTuanChan": "vueData.form.ApDungTuanChan"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Cập nhật thành công"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "savePhanCong": {
        "IF": "vueData.addNew == 1",
        "THEN": {
          "CALL": "insertPhanCong"
        },
        "ELSE": {
          "CALL": "updatePhanCong"
        }
      }
    },
    {
      "CALL": "fetchPhanCong"
    },
    {
      "CALL": "fetchOptions"
    }
  ],
  "watch": {
    "filterKhoi": {
      "CALL": "fetchPhanCong"
    },
    "filterKeyword": {
      "CALL": "fetchPhanCong"
    },
    "filterHocKy": {
      "CALL": "fetchPhanCong"
    },
    "xemMonMa": {
      "CALL": "fetchXemMon"
    },
    "xemGVMa": {
      "CALL": "fetchXemGV"
    }
  },
