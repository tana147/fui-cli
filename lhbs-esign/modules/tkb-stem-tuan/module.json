    {
      "fetchGVToTuNhien": {
        "API": "/TkbGiaoVienListTheoTo",
        "IN": {
          "To": "`Tự nhiên"
        },
        "OUT": "dsGVToTuNhien"
      }
    },
    {
      "fetchPhanCong": {
        "API": "/StemPhanCongList",
        "IN": {
          "Khoi": "vueData.filterKhoi",
          "TuTuan": "vueData.filterTuTuan",
          "DenTuan": "vueData.filterDenTuan"
        },
        "OUT": "dsPhanCong",
        "CALLBACK": [
          {
            "EXE": "vueData.dsPhanCong = vueData.dsPhanCong.map(function(r){ var fmt = function(d){ if(!d) return ''; var p = String(d).slice(0,10).split('-'); return p[2]+'/'+p[1]; }; return Object.assign({}, r, {TuanDisplay: r.NgayBatDau ? (fmt(r.NgayBatDau)+' - '+fmt(r.NgayKetThuc)) : ('Tuần '+r.ThuTuTuan)}); })"
          },
          {
            "EXE": "if(vueData.dlChiTiet){ vueData.chiTietRows = vueData.dsPhanCong.filter(function(r){return r.ThuTuTuan===vueData.chiTietThuTuTuan && r.Khoi===vueData.chiTietKhoiValue;}); }"
          }
        ]
      }
    },
    {
      "insertForm": {
        "API": "/StemPhanCongInsert",
        "IN": {
          "ThuTuTuan": "vueData.form.ThuTuTuan",
          "Khoi": "vueData.form.Khoi",
          "MaLop": "vueData.form.MaLop",
          "MonPhuTrach": "vueData.form.MonPhuTrach",
          "ChuDe": "vueData.form.ChuDe",
          "MaGV": "vueData.form.MaGV"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Thêm thành công"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "updateForm": {
        "API": "/StemPhanCongUpdate",
        "IN": {
          "StemPhanCongID": "vueData.form.StemPhanCongID",
          "ThuTuTuan": "vueData.form.ThuTuTuan",
          "Khoi": "vueData.form.Khoi",
          "MaLop": "vueData.form.MaLop",
          "MonPhuTrach": "vueData.form.MonPhuTrach",
          "ChuDe": "vueData.form.ChuDe",
          "MaGV": "vueData.form.MaGV"
        },
        "CALLBACK": [
          {
            "EXE": "vueData.dlForm = false"
          },
          {
            "MESS": "Cập nhật thành công"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "saveForm": {
        "IF": "vueData.addNew == 1",
        "THEN": {
          "CALL": "insertForm"
        },
        "ELSE": {
          "CALL": "updateForm"
        }
      }
    },
    {
      "xoaPhanCong": {
        "API": "/StemPhanCongDelete/`{{vueData.chiTietXoaItem.StemPhanCongID}}",
        "CALLBACK": [
          {
            "EXE": "vueData.dlXoaConfirm = false"
          },
          {
            "MESS": "Đã xoá"
          },
          {
            "CALL": "fetchPhanCong"
          }
        ]
      }
    },
    {
      "CALL": "fetchGVToTuNhien"
    },
    {
      "CALL": "fetchPhanCong"
    }
