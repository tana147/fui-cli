{
  "data": [
    {
      "DSNienKhoa": [],
      "NienKhoa": null
    },
    {
      "API": "lms/NienKhoa_Get",
      "OUT": "DSNienKhoa",
      "CALLBACK": {
        "EXE": "vueData.NienKhoa = parseInt(vueData.nienkhoa ?? 0) || (vueData.DSNienKhoa.find(nk => nk.IsActive == true) || vueData.DSNienKhoa[0] || {}).NienKhoa"
      }
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid pa-0",
      "rows": [
        {
          "prop": ":no-gutters='true'",
          "cols": [
            {
              "el": "uc-thong-ke-xep-loai",
              "w": 12,
              "attr": {
                ":ds-nien-khoa": "DSNienKhoa",
                ":nien-khoa": "NienKhoa"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}