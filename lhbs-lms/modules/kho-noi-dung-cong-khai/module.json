{
  "data": [
    {
      "EXE": "IsCheck_NotRoleParent(vueData.user)"
    },
    {
      "CapID": "parseInt(capid)"
    },
    {
      "KhoiID": "parseInt(KhoiID)"
    },
    {
      "MonHocID": "parseInt(MonHocID)"
    },
    {
      "NienKhoa": "parseInt(NienKhoa)",
      "NienKhoaItem": null
    },
    {
      "API": "lms/NienKhoa_Get",
      "OUT": "DSNienKhoa",
      "CALLBACK": {
        "EXE": "vueData.NienKhoaItem = vueData.DSNienKhoa.find(x => x.IsActive)"
      }
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid pa-0",
      "rows": [
        {
          "prop": ":no-gutters='true'",
          "cols": [
            {
              "el": "uc-main-layout",
              "attr": {
                "v-if": "NienKhoaItem"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}