{
  "data": [
    {
      "CapID": "parseInt(capid)",
      "HocKi": "hk",
      "DSNienKhoa": [],
      "NienKhoa": null
    },
    {
      "API": "lms/NienKhoa_Get",
      "OUT": "DSNienKhoa",
      "CALLBACK": {
        "EXE": "vueData.NienKhoa = parseInt(vueData.nienkhoa ?? 0) || (vueData.DSNienKhoa.find(nk => nk.IsActive == true) || {}).NienKhoa"
      }
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid pa-0",
      "rows": [
        {
          "prop": ":no-gutters='true'",
          "cols": [
            {
              "el": "uc-main-layout",
              "attr": {
                "v-if": "NienKhoa"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}