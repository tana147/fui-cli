{
  "data": [
    {
      "EXE": "IsCheck_NotRoleParent(vueData.user)"
    },
    {
      "ChuKyObj": null
    },
    {
      "getChuKyUser": {
        "API": "lms/ChuKy_Get_ByUserID",
        "OUT": "ChuKyObj"
      }
    },
    {
      "updateChuKyUser": {
        "API": "lms/ChuKy_Udp",
        "IN": {
          "ChuKyID": "vueData.ChuKyObj.ChuKyID",
          "GiaoVienID": "vueData.ChuKyObj.GiaoVienID",
          "HinhAnhChuKy": "vueData.ChuKyObj.HinhAnhChuKy"
        },
        "MESS": "Cập nhật chữ kí thành công",
        "CALLBACK": {
          "CALL": "getChuKyUser"
        }
      }
    },
    {
      "CALL": "getChuKyUser"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "justify-center align-center",
          "cols": [
            {
              "el": "v-card",
              "attr": {
                "class": "mx-auto",
                "width": 600
              },
              "innerHTML": [
                {
                  "el": "v-card-title",
                  "attr": {
                    "class": "text-primary"
                  },
                  "innerHTML": "Cập nhật chữ kí"
                },
                {
                  "el": "v-card-text",
                  "innerHTML": "<uc-update-chu-ky-user />"
                },
                {
                  "el": "v-card-actions",
                  "innerHTML": "<v-spacer></v-spacer> <f-button label='Cập nhật chữ kí' color='primary' prepend-icon='mdi-file-sign' variant='outlined' :action='updateChuKyUser'></f-button>"
                }
              ],
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}