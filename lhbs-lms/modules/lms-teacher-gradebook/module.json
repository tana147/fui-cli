{
  "data": [
    {
      "LopID": "parseInt(LopID)",
      "MonHocID": "parseInt(MonHocID)",
      "AssignType": "AssignType",
      "HocKi": "HocKi",
      "NienKhoa": "NienKhoa",
      "DSNienKhoa": []
    },
    {
      "NienKhoa_Get": {
        "API": "lms/NienKhoa_Get",
        "OUT": "DSNienKhoa",
        "CALLBACK": {
          "EXE": "const active = vueData.DSNienKhoa.find(x => x.IsActive); vueData.NienKhoa = vueData.NienKhoa || active?.NienKhoa || null; vueData.HocKi = vueData.HocKi || active?.HocKi || null;"
        }
      }
    },
    {
      "CALL": "NienKhoa_Get"
    },
    {
      "CallTest": {
        "#PARENT": [
          {
            "EXE": "app.config.globalProperties.v_OpenWindowList.pop()"
          },
          {
            "CALL": "initPage()"
          }
        ]
      }
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid pa-0",
      "rows": [
        {
          "cols": [
            {
              "el": "uc-gradebook",
              "w": 12,
              "attr": {
                "v-if": "NienKhoa && HocKi",
                ":initial-lop-id": "LopID",
                ":initial-mon-hoc-id": "MonHocID",
                ":initial-hoc-ki": "HocKi",
                ":initial-nien-khoa": "NienKhoa"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}