{
  "data": [
    {
      "dataReady": false,
      "isEditMode": false,
      "canEdit": true,
      "lesson": null,
      "selectedElementIndex": null
    },
    {
      "getLessonData": {
        "API": "lms/EL_Lesson_GetDetail",
        "IN": {
          "LessonID": "vueData.LessonID"
        },
        "OUT": "Lesson_API",
        "CALLBACK": [
          {
            "EXE": "console.log('running api...')"
          },
          {
            "EXE": "processInitialData(vueData.Lesson_API)"
          }
        ]
      }
    },
    {
      "EXE": "initPage()"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid pa-0",
      "rows": [
        {
          "prop": ":no-gutters= 'true'",
          "cols": [
            {
              "el": "uc-lesson-builder",
              "w": 12,
              "attr": {
                "v-if": "dataReady",
                ":initial-lesson": "lesson",
                ":is-edit-mode": "isEditMode",
                ":can-edit": "canEdit",
                ":on-save": "saveLesson"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}