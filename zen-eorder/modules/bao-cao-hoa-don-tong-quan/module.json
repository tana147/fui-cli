{
  "data": [
    {
      "DSTinhTrang": [
        {
          "value": 1,
          "text": "Chờ xử lý"
        },
        {
          "value": 2,
          "text": "Chờ thanh toán"
        },
        {
          "value": 3,
          "text": "Đã thanh toán"
        },
        {
          "value": 4,
          "text": "Đã hoàn tất"
        },
        {
          "value": 5,
          "text": "Đã hủy"
        },
        {
          "value": 6,
          "text": "Đã thanh toán một phần"
        },
        {
          "value": 7,
          "text": "Đã trả hàng"
        },
        {
          "value": 8,
          "text": "Đang đặt trước"
        },
        {
          "value": 9,
          "text": "Đang tiếp nhận"
        }
      ]
    },
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')"
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_HoaDon_TongQuan",
        "IN": {
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay",
          "CuaHangID": "CuaHangID",
          "TrangThai": "vueData.TinhTrang ? vueData.TinhTrang.join(',') : ''"
        },
        "OUT": "DSChiTietHoaDon"
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "v-select",
              "w": 3,
              "attr": {
                "v-model": "TinhTrang",
                "multiple": true,
                "label": "Trạng thái",
                ":items": "vueData.DSTinhTrang"
              }
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo tổng quan đơn hàng",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 176px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Mã đơn hàng",
                    "value": "MaDonHang"
                  },
                  {
                    "text": "Ngày đặt hàng",
                    "value": "NgayDatHang"
                  },
                  {
                    "text": "Giờ đặt hàng",
                    "value": "GioDatHang"
                  },
                  {
                    "text": "Mã khách hàng",
