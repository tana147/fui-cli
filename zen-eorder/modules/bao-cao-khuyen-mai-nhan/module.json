                    "value": "Nhan_TenCuaHang",
                    "width": 300
                  },
                  {
                    "text": "Mã hóa đơn nhận",
                    "align": "center",
                    "value": "Nhan_MaHoaDon",
                    "width": 100
                  },
                  {
                    "text": "Ngày nhận",
                    "align": "center",
                    "value": "NgayNhan",
                    "width": 100
                  },
                  {
                    "text": "Giờ nhận",
