{
  "data": [
    {
      "Keyword": "",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')"
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_KhuyenMai_KhachHang_Nhan",
        "IN": {
          "Search": "Keyword",
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay"
        },
        "OUT": "DSChiTietKhuyenMai"
      }
    },
    {
      "CALL": "getBaoCao"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-text-field",
              "w": 4,
              "attr": {
                "v-model": "Keyword",
                "label": "Tìm theo số điện thoại, mã khách hàng",
                ":rules": false
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày (Nhận Voucher)",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày (Nhận voucher)",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo khách hàng nhận voucher",
                ":items": "DSChiTietKhuyenMai",
                ":excel": true,
                "height": "calc(100vh - 176px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "SĐT khách hàng",
                    "value": "DienThoai",
                    "width": 150
                  },
                  {
                    "text": "Tên khách hàng",
                    "value": "HoTen",
                    "width": 200
                  },
                  {
