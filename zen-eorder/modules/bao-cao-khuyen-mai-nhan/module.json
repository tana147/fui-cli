                    "width": 300
                  },
                  {
                    "text": "Trạng thái",
                    "align": "center",
                    "value": "TenTrangThai",
                    "width": 100
                  },
                  {
                    "text": "Hình thức nhận",
                    "align": "center",
                    "value": "HinhThuc_Nhan",
                    "width": 100
                  },
                  {
