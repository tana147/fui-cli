{
  "data": [
    {
      "getDonViTinh": {
        "API": "/eorder/DonViTinh_Select",
        "OUT": "DSDonViTinh"
      }
    },
    {
      "CALL": "getDonViTinh"
    }
  ],
  "controls": [
    {
      "prop": "fluid page-container pt-1 grid-list-md",
      "rows": [
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Đơn vị tính",
                ":excel": true,
                ":items": "DSDonViTinh",
                "height": "calc(100vh - 63px)",
                ":headers": [
                  {
                    "text": "Tên đơn vị tính",
                    "value": "TenDVT"
                  },
                  {
                    "text": "",
                    "value": "ctrl-update",
                    "align": "center",
                    "width": 80
                  }
                ],
                ":update-form": [
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "TenDVT",
                      "label": "Tên Đơn vị tính"
                    },
                    "w": 12
                  }
                ],
                ":update-api": {
                  "new": {
                    "CONFIRM": "Bạn có muốn thêm mới đơn vị tính",
                    "API": "/eorder/DonViTinh_Insert",
                    "IN": {
                      "TenDVT": "item.TenDVT"
                    },
                    "MESS": "Thêm mới thành công",
                    "CALLBACK": {
                      "CALL": "getDonViTinh"
                    }
                  },
                  "edit": {
                    "CONFIRM": "Bạn có muốn cập nhật đơn vị tính <br/><b>{{item.TenDVT}}</b>",
                    "API": "/eorder/DonViTinh_Update",
                    "IN": {
                      "DonViTinhID": "item.DonViTinhID",
                      "TenDVT": "item.TenDVT"
                    },
                    "MESS": "Cập nhật thành công",
                    "CALLBACK": [
                      {
                        "CALL": "getDonViTinh"
                      }
                    ]
                  },
                  "delete": {
                    "CONFIRM": "Bạn có muốn xóa đơn vị tính <br/><b>{{item.TenDVT}}</span>",
                    "API": "/eorder/DonViTinh_Delete",
                    "IN": {
                      "DonViTinhID": "item.DonViTinhID"
                    },
                    "MESS": "Xóa thành công",
                    "CALLBACK": [
                      {
                        "CALL": "getDonViTinh"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}