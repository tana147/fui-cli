{
  "data": [
    {
      "ManHinhID": "id",
      "DSManHinh_Filter": []
    },
    {
      "API": "/eordertest/ManHinhChiTiet_Select_ById",
      "IN": {
        "ManHinhID": "vueData.ManHinhID"
      },
      "OUT": "CTManHinh"
    },
    {
      "API": "/eordertest/ManHinh_Select",
      "OUT": "DSManHinh",
      "CALLBACK": [
        {
          "DSManHinh_Filter": "vueData.DSManHinh.filter(item => item.ManHinhID === parseInt(vueData.ManHinhID))"
        }
      ]
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "grid-list-md fluid text-center",
      "rows": [
        {
          "prop": "justify-center",
          "cols": [
            {
              "el": "uc-slide-show",
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}