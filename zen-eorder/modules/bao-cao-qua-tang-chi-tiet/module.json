{
  "data": [
    {
      "Ngay": "moment().format('YYYY-MM-DD')",
      "DataSummary": {
        "Tong_Ly": 0,
        "Tong_LyThoaDieuKien": 0,
        "TyLe": 0,
        "Tong_QrTrungThuong": 0,
        "Tong_ChuaQuet": 0,
        "Tong_DaQuet": 0,
        "Tong_ChuaNhapMaPin": 0,
        "Tong_DaNhapMaPin": 0,
        "Tong_ChuaDoiThuong": 0,
        "Tong_DaDoiThuong": 0,
        "Tong_DaDoiThuong_ThucTe": 0
      }
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_QuaTang_ChiTiet",
        "IN": {
          "Ngay": "Ngay"
        },
        "OUT": "DSChiTietQuaTang",
        "CALLBACK": {
          "EXE": "sumFooterTable()"
        }
      }
    }
  ],
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "f-date",
              "attr": {
                "v-model": "Ngay",
                "label": "Ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-summary",
              "attr": {
                ":data": "vueData.DataSummary"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo quà tặng chi tiết",
                ":items": "DSChiTietQuaTang",
                ":excel": true,
                "height": "calc(100vh - 185px)",
                ":headers": [
                  {
                    "text": "Cửa hàng",
                    "value": "TenCuaHang"
                  },
                  {
                    "text": "Ngày",
                    "value": "Ngay"
                  },
                  {
                    "text": "Tổng ly",
                    "value": "Tong_Ly",
                    "el": "span",
                    "innerHTML": "{{item.Tong_Ly?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Ly thỏa điều kiện",
                    "value": "Tong_LyThoaDieuKien",
                    "el": "span",
                    "innerHTML": "{{item.Tong_LyThoaDieuKien?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tỷ lệ (%)",
                    "value": "TyLe",
                    "el": "span",
                    "innerHTML": "{{item.TyLe?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tổng QR thưởng",
                    "value": "TongQrCode_TrungThuong",
                    "el": "span",
                    "innerHTML": "{{item.Tong_QrTrungThuong?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Chưa quét mã trên ly",
                    "value": "Tong_ChuaQuet",
                    "el": "span",
                    "innerHTML": "{{item.Tong_ChuaQuet?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Đã quét mã trên ly",
                    "value": "Tong_DaQuet",
                    "el": "span",
                    "innerHTML": "{{item.Tong_DaQuet?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Chưa nhập mã PIN",
                    "value": "Tong_ChuaNhapMaPin",
                    "el": "span",
                    "innerHTML": "{{item.Tong_ChuaNhapMaPin?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Đã nhập mã PIN",
                    "value": "Tong_DaNhapMaPin",
                    "el": "span",
                    "innerHTML": "{{item.Tong_DaNhapMaPin?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Chưa đổi thưởng",
                    "value": "Tong_ChuaDoiThuong",
                    "el": "span",
                    "innerHTML": "{{item.Tong_ChuaDoiThuong?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Đã đổi thưởng",
                    "value": "Tong_DaDoiThuong",
                    "el": "span",
                    "innerHTML": "{{item.Tong_DaDoiThuong?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Đổi thưởng thực tế",
                    "value": "Tong_DaDoiThuong_ThucTe",
                    "el": "span",
                    "innerHTML": "{{item.Tong_DaDoiThuong_ThucTe?.toLocaleString('vi-vn')}}"
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}