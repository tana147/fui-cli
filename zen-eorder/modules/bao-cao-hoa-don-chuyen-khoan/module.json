{
  "data": [
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')",
      "DataSummary": null
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_HoaDon_ChuyenKhoan",
        "IN": {
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay",
          "CuaHangID": "CuaHangID"
        },
        "OUT": "DSChiTietHoaDon",
        "CALLBACK": {
          "EXE": "sumFooterTable()"
        }
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-summary",
              "attr": {
                ":data": "vueData.DataSummary"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo chuyển khoản",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 243px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Mã đơn hàng",
                    "value": "MaDonHang"
                  },
                  {
                    "text": "Loại đơn hàng",
                    "value": "LoaiDonHang"
                  },
                  {
                    "text": "Nhân viên thêm mới",
                    "value": "NhanVienThemMoi"
                  },
                  {
                    "text": "Nhân viên thanh toán",
                    "value": "NhanVienThanhToan"
                  },
                  {
                    "text": "Ngày",
                    "value": "Ngay"
                  },
                  {
                    "text": "Tiền hàng",
                    "value": "TienHang",
                    "el": "span",
                    "innerHTML": "{{item.TienHang?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Số tiền CK",
                    "value": "SoTienCK",
                    "el": "span",
                    "innerHTML": "{{item.SoTienCK?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tên cửa hàng",
                    "value": "TenCuaHang",
                    "width": 300
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}