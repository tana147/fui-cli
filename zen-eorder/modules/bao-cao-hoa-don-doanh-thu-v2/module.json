        },
        {
          "text": "Cửa hàng",
          "value": "CuaHang",
          "width": 300
        }
      ]
    },
    {
      "API": "/eorder/KhuVuc_Select",
      "OUT": "DSKhuVuc",
      "CALLBACK": [
        {
          "EXE": "DSKhuVuc.unshift({'KhuVucID': 0, 'TenKhuVuc': 'Tất cả'})"
        }
      ]
    },
    {
      "API": "/eorder/PhanHieu_Select",
      "OUT": "DSPhanHieu",
      "CALLBACK": [
        {
          "EXE": "DSPhanHieu.unshift({'PhanHieuID': 0, 'TenPhanHieu': 'Tất cả'})"
        }
      ]
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        },
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_HoaDon_DoanhThu_v2",
        "IN": {
          "CuaHangID": "CuaHangID",
          "HinhThucThanhToan": "HinhThucThanhToan",
          "HinhThucThoiGian": "HinhThucThoiGian",
          "Ngay": "Ngay ?? -1",
          "TuNgay": "TuNgay ?? -1",
          "DenNgay": "DenNgay ?? -1",
          "Nam": "Nam ?? -1",
          "TuNam": "TuNam ?? -1",
          "DenNam": "DenNam ?? -1",
          "Thang": "Thang ?? -1"
        },
        "OUT": "DSChiTietHoaDon",
        "CALLBACK": [
          {
            "EXE": "sumFooterTable()"
          },
          {
            "EXE": "handleColumnHinhThucThoiGian(HinhThucThoiGian)"
          }
        ]
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ],
    "HinhThucThoiGian": [
      {
        "EXE": "handleColumnHinhThucThoiGian(HinhThucThoiGian)"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-filter"
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-summary",
              "attr": {
                ":data": "vueData.DataSummary"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo doanh thu",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 293)",
                ":hide-default-footer": false,
                ":headers": "headers"
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}