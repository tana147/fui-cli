        },
        {
          "text": "HT1",
          "value": "KhachTra_HT1",
          "align": "right",
          "el": "span",
          "innerHTML": "{{item.KhachTra_HT1?.toLocaleString('vi-vn')}}"
        },
        {
          "text": "HT2",
          "value": "KhachTra_HT2",
          "align": "right",
