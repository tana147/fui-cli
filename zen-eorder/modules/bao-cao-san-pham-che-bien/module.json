{
  "data": [
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')"
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_SanPham_ThoiGianCheBien",
        "IN": {
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay",
          "CuaHangID": "CuaHangID"
        },
        "OUT": "DSChiTietHoaDon"
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo thời gian chế biến",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 176px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Mã đơn hàng",
                    "value": "MaDonHang"
                  },
                  {
                    "text": "Loại đơn hàng",
                    "value": "LoaiDonHang",
                    "width": 150
                  },
                  {
                    "text": "Số lượng",
                    "value": "SoLuong",
                    "el": "span",
                    "innerHTML": "{{item.SoLuong?.toLocaleString('vi-vn')}} {{item.TenDonViTinh}}"
                  },
                  {
                    "text": "Tên món",
                    "value": "TenMon",
                    "width": 250
                  },
                  {
                    "text": "Thêm mới",
                    "value": "NhanVienThemMoi"
                  },
                  {
                    "text": "Thanh toán",
                    "value": "NhanVienThanhToan"
                  },
                  {
                    "text": "Thời gian từ",
                    "value": "ThoiGian",
                    "el": "span",
                    "innerHTML": "Từ: {{item.ThoiGianThemMoi}}",
                    "width": 170
                  },
                  {
                    "text": "Thời gian đến",
                    "value": "ThoiGian",
                    "el": "span",
                    "innerHTML": "{{item.ThoiGianHoanThanh}}",
                    "width": 170
                  },
                  {
                    "text": "Hoàn thành",
                    "value": "ThoiGianHoanThanh_Gio"
                  },
                  {
                    "text": "TT Bếp",
                    "value": "TrangThai_Bep",
                    "width": 150
                  },
                  {
                    "text": "Cửa hàng",
                    "value": "TenCuaHang",
                    "width": 300
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}