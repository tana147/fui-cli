    }
  },
  "controls": [
    {
      "prop": "fluid",
      "rows": [
        {
          "prop": {},
          "cols": [
            {
              "el": "uc-waiting",
              "attr": {
                ":ds_hoadon": "DSHoaDon"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {
    "menu": false,
    "menuLeft": false
  }
}