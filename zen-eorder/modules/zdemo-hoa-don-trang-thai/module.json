{
  "data": [
    {
      "CuaHangID": "chid",
      "webSocket_Hub_Waiting": "`waiting_{{CuaHangID}}",
      "webSocket": "{[webSocket_Hub_Waiting]: null }"
    },
    {
      "getHoaDonCho": {
        "API": "/eordertest/HoaDon_Select_ManHinhCho",
        "IN": {
          "CuaHangID": "CuaHangID"
        },
        "OUT": "DSHoaDon"
      }
    },
    {
      "CALL": "getHoaDonCho"
    }
  ],
