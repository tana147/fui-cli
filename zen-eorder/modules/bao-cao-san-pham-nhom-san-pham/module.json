{
  "data": [
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')",
      "DataSummary": null
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_SanPham_NhomSanPham",
        "IN": {
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay",
          "CuaHangID": "CuaHangID"
        },
        "OUT": "DSChiTietHoaDon",
        "CALLBACK": {
          "EXE": "sumFooterTable()"
        }
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-summary",
              "attr": {
                ":data": "vueData.DataSummary"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo thống kê nhóm sản phẩm bán",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 243px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Ngày đặt hàng",
                    "value": "NgayDatHang"
                  },
                  {
                    "text": "Nhóm sản phẩm",
                    "value": "TenNhomSanPham"
                  },
                  {
                    "text": "Đơn vị",
                    "value": "DonVi"
                  },
                  {
                    "text": "Số lượng bán",
                    "value": "SoLuongBan"
                  },
                  {
                    "text": "Doanh thu",
                    "value": "DoanhThu",
                    "el": "span",
                    "innerHTML": "{{item.DoanhThu?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Số lượng tặng",
                    "value": "SoLuongTang"
                  },
                  {
                    "text": "Giá trị tặng",
                    "value": "GiaTriTang"
                  },
                  {
                    "text": "Số lượng hủy",
                    "value": "SoLuongHuy"
                  },
                  {
                    "text": "Tiền hủy",
                    "value": "TienHuy",
                    "el": "span",
                    "innerHTML": "{{item.TienHuy?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Số lượng đổi điểm",
                    "value": "SoLuongDoiDiem"
                  },
                  {
                    "text": "Tiền đổi điểm",
                    "value": "TienDoiDiem",
                    "el": "span",
                    "innerHTML": "{{item.TienDoiDiem?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Số lượng trả",
                    "value": "SoLuongTra"
                  },
                  {
                    "text": "Tiền trả",
                    "value": "TienTra",
                    "el": "span",
                    "innerHTML": "{{item.TienTra?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Cửa hàng",
                    "value": "CuaHang",
                    "width": 300
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}