{
  "data": [
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "Keyword": "",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')"
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_Diem_SuDung",
        "IN": {
          "CuaHangID": "CuaHangID",
          "Search": "Keyword",
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay"
        },
        "OUT": "DSChiTietBaoCao"
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "v-text-field",
              "w": 3,
              "attr": {
                "v-model": "Keyword",
                "label": "Tìm theo số điện thoại, mã khách hàng",
                ":rules": false
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo tần suất sử dụng ZEN",
                ":items": "DSChiTietBaoCao",
                ":excel": true,
                "height": "calc(100vh - 176px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Mã khách hàng",
                    "value": "KhachHangID",
                    "width": 150
                  },
                  {
                    "text": "Tên khách hàng",
                    "value": "HoTen"
                  },
                  {
                    "text": "Điện thoại",
                    "value": "DienThoai",
                    "width": 150
                  },
                  {
                    "text": "Điểm hiện có",
                    "value": "DiemHienCo",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.DiemHienCo?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Sử dụng điểm (Lần)",
                    "value": "SoLan_SuDung",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.SoLan_SuDung?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tích điểm (Lần)",
                    "value": "SoLan_TichDiem",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.SoLan_TichDiem?.toLocaleString('vi-vn')}}"
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}