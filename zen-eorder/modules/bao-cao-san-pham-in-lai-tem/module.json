{
  "data": [
    {
      "Keyword": "",
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "CuaHangID": 0,
      "PhanHieuID": 0,
      "KhuVucID": 0,
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')"
    },
    {
      "API": "/eorder/PhanHieu_Select",
      "OUT": "DSPhanHieu",
      "CALLBACK": [
        {
          "EXE": "vueData.DSPhanHieu.unshift({PhanHieuID: 0, TenPhanHieu: 'Tất cả'})"
        }
      ]
    },
    {
      "API": "/eorder/KhuVuc_Select",
      "OUT": "DSKhuVuc",
      "CALLBACK": [
        {
          "EXE": "vueData.DSKhuVuc.unshift({KhuVucID: 0, TenKhuVuc: 'Tất cả'})"
        }
      ]
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_SanPham_InLaiTem",
        "IN": {
          "PhanHieuID": "PhanHieuID",
          "KhuVucID": "KhuVucID",
          "CuaHangID": "CuaHangID",
          "Search": "Keyword",
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay"
        },
        "OUT": "DSSanPham"
      }
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ],
    "PhanHieuID": [
      {
        "CALL": "getBaoCao"
      }
    ],
    "KhuVucID": [
      {
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 6,
              "attr": {
                "v-model": "PhanHieuID",
                "label": "Phân hiệu",
                ":items": "vueData.DSPhanHieu",
                "item-value": "PhanHieuID",
                "item-text": "TenPhanHieu"
              }
            },
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "KhuVucID",
                "label": "Khu vực",
                ":items": "vueData.DSKhuVuc",
                "item-value": "KhuVucID",
                "item-text": "TenKhuVuc"
              }
            },
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "v-text-field",
              "w": 3,
              "attr": {
                "v-model": "Keyword",
                "label": "Tìm theo mã hóa đơn",
                ":rules": false
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo số lần in tem",
                ":items": "DSSanPham",
                ":excel": true,
                "height": "calc(100vh - 176px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Cửa hàng",
                    "value": "TenCuaHang"
                  },
                  {
                    "text": "Mã hóa đơn",
                    "value": "MaHoaDon"
                  },
                  {
                    "text": "Sản phẩm",
                    "value": "TenHienThi"
                  },
                  {
                    "text": "Thứ tự ly",
                    "value": "SoThuTu"
                  },
                  {
                    "text": "Nhân viên thực hiện",
                    "value": "NhanVienCapNhat"
                  },
                  {
                    "text": "Lần in",
                    "value": "LanIn"
                  },
                  {
                    "text": "Ngày in",
                    "value": "NgayIn"
                  },
                  {
                    "text": "Giờ in",
                    "value": "GioIn"
                  },
                  {
                    "text": "Ngày thêm mới",
                    "value": "NgayThemMoi"
                  },
                  {
                    "text": "Giờ thêm mới",
                    "value": "GioThemMoi"
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}