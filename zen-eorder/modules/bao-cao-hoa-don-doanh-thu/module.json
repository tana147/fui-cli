{
  "data": [
    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')",
      "DataSummary": null,
      "HinhThucThanhToan": 0,
      "DSHinhThucThanhToan": [
        {
          "value": 0,
          "text": "Tất cả"
        },
        {
          "value": 1,
          "text": "Tiền mặt"
        },
        {
          "value": 2,
          "text": "Chuyển khoản"
        },
        {
          "value": 4,
          "text": "Quẹt thẻ"
        },
        {
          "value": 3,
          "text": "Shopee Food"
        },
        {
          "value": 5,
          "text": "ZEN"
        },
        {
          "value": 6,
          "text": "Grab"
        },
        {
          "value": 7,
          "text": "XSM"
        },
        {
          "value": 8,
          "text": "HT1"
        },
        {
          "value": 9,
          "text": "HT2"
        },
        {
          "value": 10,
          "text": "HT3"
        }
      ]
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "CuaHangID": "(vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_HoaDon_DoanhThu",
        "IN": {
          "CuaHangID": "CuaHangID",
          "HinhThucThanhToan": "HinhThucThanhToan",
          "TuNgay": "TuNgay",
          "DenNgay": "DenNgay"
        },
        "OUT": "DSChiTietHoaDon",
        "CALLBACK": {
          "EXE": "sumFooterTable()"
        }
      }
    },
    {
      "CALL": "getBaoCao"
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "v-select",
              "w": 4,
              "attr": {
                "v-model": "CuaHangID",
                "label": "Cửa hàng",
                ":items": "vueData.DSCuaHang",
                "item-value": "CuaHangID",
                "item-text": "TenCuaHang"
              }
            },
            {
              "el": "v-select",
              "w": 2,
              "attr": {
                "v-model": "HinhThucThanhToan",
                "label": "Hình thức thanh toán",
                ":items": "vueData.DSHinhThucThanhToan"
              }
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "TuNgay",
                "label": "Từ ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-date",
              "attr": {
                "v-model": "DenNgay",
                "label": "Đến ngày",
                "date-add": 0
              },
              "w": 2
            },
            {
              "el": "f-button",
              "attr": {
                "color": "primary",
                "icon-text": "mdi-filter",
                "label": "Tìm",
                ":action": {
                  "CALL": "getBaoCao"
                }
              },
              "w": 3
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-summary",
              "attr": {
                ":data": "vueData.DataSummary"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo doanh thu",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 243px)",
                ":hide-default-footer": false,
                ":headers": [
                  {
                    "text": "Ngày đặt hàng",
                    "value": "NgayDatHang"
                  },
                  {
                    "text": "Tiền hàng",
                    "value": "TienHang",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TienHang?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tiền VAT",
                    "value": "TongVAT",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TongVAT?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tạm tính",
                    "value": "TamTinh",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TamTinh?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Chờ thanh toán",
                    "value": "TienChoThanhToan",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TienChoThanhToan?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tổng ZEN sử dụng",
                    "value": "TongDiemSuDung",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TongDiemSuDung?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tiền thanh toán",
                    "value": "TongTienThanhToan",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TongTienThanhToan?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Tiền mặt",
                    "value": "TienMat",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TienMat?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Chuyển khoản",
                    "value": "ChuyenKhoan",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.ChuyenKhoan?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "ShopeeFood",
                    "value": "KhachTra_SPF",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_SPF?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Grab",
                    "value": "KhachTra_GRAB",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_GRAB?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Xanh SM",
                    "value": "KhachTra_XSM",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_XSM?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "HT1",
                    "value": "KhachTra_HT1",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_HT1?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "HT2",
                    "value": "KhachTra_HT2",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_HT2?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "HT3",
                    "value": "KhachTra_HT3",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_HT3?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Quẹt thẻ",
                    "value": "KhachTra_QuetThe",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.KhachTra_QuetThe?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Khuyến mãi",
                    "value": "KhuyenMai"
                  },
                  {
                    "text": "Tổng tiền hủy",
                    "value": "TongTienHuy",
                    "align": "right",
                    "el": "span",
                    "innerHTML": "{{item.TongTienHuy?.toLocaleString('vi-vn')}}"
                  },
                  {
                    "text": "Cửa hàng",
                    "value": "CuaHang",
                    "width": 300
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}