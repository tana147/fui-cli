    {
      "CuaHangID_Local": "localStorage.getItem('CuaHangID')",
      "TuNgay": "moment().format('YYYY-MM-DD')",
      "DenNgay": "moment().format('YYYY-MM-DD')",
      "HinhThucThanhToan": 0,
      "TrangThaiMon": 0
    },
    {
      "API": "/eorder/KhuVuc_Select",
      "OUT": "DSKhuVuc",
      "CALLBACK": [
        {
          "EXE": "DSKhuVuc.unshift({'KhuVucID': 0, 'TenKhuVuc': 'Tất cả'})"
        }
      ]
    },
    {
      "API": "/eorder/CuaHang_Select",
      "OUT": "DSCuaHang",
      "CALLBACK": [
        {
          "EXE": " vueData.CuaHangID = (vueData.CuaHangID_Local > 0 && DSCuaHang.length > 1) ? parseInt(vueData.CuaHangID_Local) : DSCuaHang[0].CuaHangID"
        },
        {
          "EXE": "vueData.DSCuaHang.unshift({CuaHangID: 0, TenCuaHang: 'Tất cả'})"
        }
      ]
    },
    {
      "getBaoCao": {
        "API": "/eorder/BaoCao_HoaDon_DienTu",
        "IN": {
          "HinhThucThoiGian": "HinhThucThoiGian",
          "Ngay": "Ngay ?? -1",
          "TuNgay": "TuNgay ?? -1",
          "DenNgay": "DenNgay ?? -1",
          "Nam": "Nam ?? -1",
          "TuNam": "TuNam ?? -1",
          "DenNam": "DenNam ?? -1",
          "Thang": "Thang ?? -1",
          "CuaHangID": "CuaHangID",
          "HinhThucThanhToan": "HinhThucThanhToan",
          "TrangThaiMon": "TrangThaiMon"
        },
        "OUT": "DSChiTietHoaDon",
        "CALLBACK": [
          {
            "EXE": "handleColumnHinhThucThoiGian(HinhThucThoiGian)"
          }
        ]
      }
    },
    {
      "API": "/eorder/PhanHieu_Select",
      "OUT": "DSPhanHieu",
      "CALLBACK": [
        {
          "EXE": "DSPhanHieu.unshift({'PhanHieuID': 0, 'TenPhanHieu': 'Tất cả'})"
        }
      ]
    }
  ],
  "watch": {
    "CuaHangID": [
      {
        "EXE": "localStorage.setItem('CuaHangID', CuaHangID);",
        "CALL": "getBaoCao"
      }
    ],
    "HinhThucThoiGian": [
      {
        "EXE": "handleColumnHinhThucThoiGian(HinhThucThoiGian)"
      },
      {
        "EXE": "vueData.DSChiTietHoaDon = []"
      }
    ]
  },
  "controls": [
    {
      "prop": "fluid page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-filter"
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "attr": {
                "label": "Báo cáo chi tiết hóa đơn điện tử",
                ":items": "DSChiTietHoaDon",
                ":excel": true,
                "height": "calc(100vh - 226px)",
                ":hide-default-footer": false,
                ":headers": "headers"
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}