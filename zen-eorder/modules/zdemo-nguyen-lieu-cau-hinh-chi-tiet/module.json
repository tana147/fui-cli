{
  "data": [
    {
      "SanPhamID": "nlid",
      "TabProduct": "`Tab_DuLieuCoSo",
      "IsShowDialogCloneProduct": false,
      "IsShowDialogSettingProduct": false,
      "DS_SanPham_CuaHang": []
    },
    {
      "DSTinhTrang": [
        {
          "value": 0,
          "text": "Hoạt động"
        },
        {
          "value": 1,
          "text": "Tạm khóa"
        }
      ]
    },
    {
      "getSanPhamById": {
        "API": "/eordertest/SanPham_Select_ById",
        "IN": {
          "SanPhamID": "SanPhamID"
        },
        "OUT": "CTSanPham"
      }
    },
    {
      "getSanPhamCuaHang": {
        "API": "/eordertest/SanPhamCuaHang_Select_ById",
        "IN": {
          "SanPhamID": "SanPhamID"
        },
        "OUT": "DS_SanPham_CuaHang"
      }
    },
    {
      "CALL": "getSanPhamById"
    },
    {
      "CALL": "getSanPhamCuaHang"
    }
  ],
  "watch": {},
  "controls": [
    {
      "prop": "page-container grid-list-md",
      "rows": [
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "div",
              "attr": {
                "class": "font-weight-bold"
              },
              "innerHTML": "Chi tiết sản phẩm: <span class='success--text'>{{CTSanPham?.SanPham?.TenSanPham}} - {{CTSanPham?.SanPham?.MaSanPham}}</span>"
            }
          ]
        },
        {
          "prop": "page-navigation",
          "cols": [
            {
              "el": "uc-button-action",
              "attr": {
                ":ct_sanpham": "CTSanPham?.SanPham",
                ":sp_ch": "DS_SanPham_CuaHang"
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "v-tabs",
              "attr": {
                "v-model": "TabProduct",
                "color": "white",
                "background-color": "green"
              },
              "innerHTML": [
                {
                  "el": "v-tab",
                  "attr": {
                    "key": "Tab_DuLieuCoSo"
                  },
                  "innerHTML": [
                    {
                      "el": "span",
                      "innerHTML": "Dữ liệu cơ sở"
                    }
                  ]
                },
                {
                  "el": "v-tab",
                  "attr": {
                    "key": "Tab_CuaHang"
                  },
                  "innerHTML": [
                    {
                      "el": "span",
                      "innerHTML": "Cửa hàng áp dụng"
                    }
                  ]
                },
                {
                  "el": "v-tab",
                  "attr": {
                    "key": "Tab_BuocCheBien"
                  },
                  "innerHTML": [
                    {
                      "el": "span",
                      "innerHTML": "Bước chế biến"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "v-tabs-items",
              "attr": {
                "v-model": "TabProduct"
              },
              "innerHTML": [
                {
                  "el": "v-tab-item",
                  "attr": {
                    "key": "Tab_DuLieuCoSo"
                  },
                  "innerHTML": [
                    {
                      "el": "uc-tab-du-lieu-co-so",
                      "attr": {
                        ":ct_sanpham": "CTSanPham.SanPham"
                      },
                      "w": 12
                    }
                  ]
                },
                {
                  "el": "v-tab-item",
                  "attr": {
                    "key": "Tab_CuaHang"
                  },
                  "innerHTML": [
                    {
                      "el": "uc-tab-cua-hang",
                      "attr": {
                        ":ct_sanpham": "CTSanPham.SanPham"
                      },
                      "w": 12
                    }
                  ]
                },
                {
                  "el": "v-tab-item",
                  "attr": {
                    "key": "Tab_BuocCheBien"
                  },
                  "innerHTML": [
                    {
                      "el": "uc-tab-buoc-che-bien",
                      "attr": {
                        ":ct_sanpham": "CTSanPham.SanPham"
                      },
                      "w": 12
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}