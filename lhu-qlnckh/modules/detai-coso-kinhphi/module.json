{
  "data": [
    {
      "CALL": "initFile()"
    },
    {
      "DialogFile_Open": false,
      "QDID_Edit": 0,
      "CT_QuyetDinh": null,
      "FileID_Remove": null,
      "DS_FileDecisionUpload": null,
      "DS_FileCapKinhPhi": null,
      "FileID_QD": {
        "FileName": "",
        "FileID": "",
        "FileUrl": ""
      },
      "TienDo_Obj": {
        "QDID": null,
        "SoTT": null,
        "SoTien": null,
        "NgayTienDo": null,
        "GhiChu": null,
        "SoQD": null,
        "NgayQD": null,
        "FileID": "",
        "FileName": ""
      },
      "TienDo_Obj_Default": {
        "QDID": null,
        "SoTT": null,
        "SoTien": null,
        "NgayTienDo": null,
        "GhiChu": null,
        "SoQD": null,
        "NgayQD": null,
        "FileID": "",
        "FileName": ""
      },
      "DS_TienDo_Get_ByQDID": [],
      "isLoading_KHCN_TienDo": false,
      "isSelected": [],
      "isSelectedToUpd": [],
      "QDID": null,
      "DotArr": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "KHCN_TienDo_Get_ByQDID": {
        "API": "/KHCN_TienDo_Get_ByQDID",
        "IN": {
          "QDID": "QDID_Edit"
        },
        "OUT": "DS_TienDo_Get_ByQDID",
        "CALLBACK": {
          "isLoading_KHCN_TienDo": true
        }
      }
    },
    {
      "KHCN_Get": {
        "API": "/KHCN_Get",
        "OUT": "DS_KHCN"
      }
    },
    {
      "getQuyetDinh": {
        "API": "/GiaiThuong_QuyetDinh_Get_All",
        "IN": {
          "LoaiQD": 2
        },
        "OUT": "DS_QuyetDinh"
      }
    },
    {
      "CALL": "getQuyetDinh"
    },
    {
      "CALL": "KHCN_Get"
    },
    {
      "callApiRemoveFile": {
        "CONFIRM": "Bạn có chắc muốn xóa tập tin?",
        "API": "/GiaiThuong_QuyetDinh_Upd_File",
        "IN": {
          "QDID": "vueData.CT_QuyetDinh[0][0].QDID",
          "DS_FileID": "vueData.CT_QuyetDinh[1].filter(item => item.FILE_ID !== vueData.FileID_Remove).map(item => item.FILE_ID).join(',')"
        },
        "MESS": "Xóa tập tin thành công",
        "CALLBACK": [
          {
            "FileID_Remove": null
          },
          {
            "API": "/GiaiThuong_QuyetDinh_Get_ByID",
            "IN": {
              "QDID": "vueData.CT_QuyetDinh[0][0].QDID"
            },
            "OUT": "CT_QuyetDinh",
            "CALLBACK": [
              {
                "CT_QuyetDinh": "CT_QuyetDinh",
                "DS_FileDecisionUpload": null
              }
            ]
          },
          {
            "CALL": "getQuyetDinh"
          }
        ]
      }
    }
  ],
  "watch": {
    "QDID_Edit": {
      "IF": "QDID_Edit>0",
      "THEN": {
        "CALL": "KHCN_TienDo_Get_ByQDID"
      }
    }
  },
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "",
          "cols": [
            {
              "el": "f-table",
              "col": {},
              "attr": {
                "label": "Danh sách quyết định cấp kinh phí",
                ":excel": true,
                ":items": "DS_QuyetDinh",
                ":fixed-header": true,
                ":show-select": false,
                ":fixed-cols": 2,
                ":mobile-breakpoint": 600,
                ":headers": [
                  {
                    "text": "Số quyết định",
                    "value": "MaSoQD",
                    "el": "span",
                    "attr": {
                      ":class": "item.MaSoQD === '' ? 'grey--text' : 'red--text'"
                    },
                    "innerHTML": "<b>{{item.MaSoQD === '' ? 'Chưa có' : item.MaSoQD}}</b>"
                  },
                  {
                    "text": "Mô tả",
                    "value": "MoTaQD"
                  },
                  {
                    "text": "Ngày, Tháng, Năm QĐ",
                    "value": "NgayQD",
                    "align": "center",
                    "el": "span",
                    "innerHTML": "{{item.NgayQD}}-{{item.ThangQD}}-{{item.NamQD}}"
                  },
                  {
                    "text": "Đề tài",
                    "align": "center",
                    "value": "SoGiaiThuong",
                    "el": "v-chip",
                    "attr": {
                      "color": "primary"
                    },
                    "innerHTML": "{{Number(item.SoGiaiThuong)}}"
                  },
                  {
                    "text": "Tập tin",
                    "align": "center",
                    "value": "SoTapTin",
                    "el": "v-chip",
                    "attr": {
                      "color": "primary"
                    },
                    "innerHTML": "{{ Number(item.SoTapTin)}}"
                  },
                  {
                    "text": "",
                    "value": "UploadFile",
                    "align": "center",
                    "el": "t-button",
                    "attr": {
                      "color": "primary",
                      "label": "Tập tin",
                      ":action": {
                        "API": "/GiaiThuong_QuyetDinh_Get_ByID",
                        "IN": {
                          "QDID": "item.QDID"
                        },
                        "OUT": "CT_QuyetDinh",
                        "CALLBACK": [
                          {
                            "DialogFile_Open": true,
                            "CT_QuyetDinh": "CT_QuyetDinh"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "text": "Chức năng",
                    "value": "ctrl-update",
                    "align": "center"
                  }
                ],
                ":update-form": [
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "MaSoQD",
                      "label": "Số quyết định",
                      ":rules": false
                    },
                    "w": 4
                  },
                  {
                    "el": "v-combobox",
                    "attr": {
                      "v-model": "Dot",
                      "label": "Đợt",
                      ":items": "vueData.DotArr",
                      ":rules": false
                    },
                    "w": 2
                  },
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "NgayQD",
                      "label": "Ngày QĐ",
                      "type": "number",
                      ":rules": false
                    },
                    "w": 2
                  },
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "ThangQD",
                      "label": "Tháng QĐ",
                      "type": "number",
                      ":rules": false
                    },
                    "w": 2
                  },
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "NamQD",
                      "label": "Năm QĐ",
                      "type": "number",
                      ":rules": false
                    },
                    "w": 2
                  },
                  {
                    "el": "v-textarea",
                    "attr": {
                      "v-model": "MoTaQD",
                      "label": "Mô tả quyết định",
                      "rows": 2,
                      "hide-details": true,
                      ":rules": false
                    },
                    "w": 12
                  },
                  {
                    "el": "f-file-upload",
                    "w": 3,
                    "attr": {
                      "v-model": "vueData.DS_FileCapKinhPhi",
                      "label": "Tải lên tập tin",
                      ":url": "vueData.v_Set.apiFile",
                      ":filters": "vueData.fileEX",
                      ":onclose": [
                        {
                          "EXE": "vueData.FileID_QD.FileID=vueData.DS_FileCapKinhPhi?.Files[0].FILE_ID"
                        },
                        {
                          "EXE": "vueData.FileID_QD.FileName=vueData.DS_FileCapKinhPhi?.Files[0].FILE_NAME"
                        },
                        {
                          "EXE": "vueData.FileID_QD.FileUrl=vueData.DS_FileCapKinhPhi?.Files[0].FILE_URL"
                        }
                      ]
                    }
                  },
                  {
                    "el": "div",
                    "w": 9,
                    "attr": {
                      "class": "d-flex flex-row justify-start ml-1 align-center",
                      "style": "height:100%"
                    },
                    "innerHTML": "<v-chip  v-if='vueData.FileID_QD.FileID' color= 'deep-purple accent-4' outlined :href='vueData.v_Set.urlReturnFile + vueData.FileID_QD.FileUrl' close v-on:click:close= 'del_fileItem()'>{{vueData.FileID_QD.FileName}}</v-chip>"
                  },
                  {
                    "el": "f-table",
                    "attr": {
                      "v-model": "vueData.isSelected",
                      "v-if": "vueData.QDID_Edit === 0",
                      "label": "Danh sách đề tài",
                      ":excel": true,
                      ":items": "vueData.DS_KHCN",
                      ":items-per-page": 5,
                      ":footer-props": "{'items-per-page-options':[5, 10, 50 ,100, -1]}",
                      ":fixed-header": true,
                      ":hide-default-header": false,
                      ":hide-default-footer": false,
                      "show-select": true,
                      ":fixed-cols": 2,
                      ":mobile-breakpoint": 600,
                      "item-key": "DeTaiKHCNID",
                      ":headers": [
                        {
                          "text": "Mã đề tài",
                          "value": "MaSoDeTai"
                        },
                        {
                          "text": "Tên đề tài",
                          "value": "TenDeTaiKHCN_Vi"
                        },
                        {
                          "text": "Kinh phí",
                          "value": "KinhPhi",
                          "el": "v-text-field",
                          "attr": {
                            ":dense": true,
                            ":hide-details": true,
                            ":rules": false,
                            "reverse": true,
                            "type": "number"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "el": "f-table",
                    "attr": {
                      "label": "Danh sách đề tài",
                      "v-if": "vueData.QDID_Edit !==0 && vueData.isLoading_KHCN_TienDo  ",
                      ":excel": true,
                      ":items": "vueData.DS_TienDo_Get_ByQDID",
                      ":items-per-page": 5,
                      ":footer-props": "{'items-per-page-options':[5, 10, 50 ,100, -1]}",
                      ":fixed-header": true,
                      ":hide-default-header": false,
                      ":hide-default-footer": false,
                      ":show-select": false,
                      ":fixed-cols": 2,
                      ":mobile-breakpoint": 600,
                      "item-key": "TienDoID",
                      ":headers": [
                        {
                          "text": "Mã đề tài",
                          "value": "MaSoDeTai"
                        },
                        {
                          "text": "Tên đề tài",
                          "value": "TenDeTaiKHCN_Vi"
                        },
                        {
                          "text": "Kinh phí",
                          "value": "SoTien",
                          "el": "c-text-field-format-price",
                          "attr": {
                            "hide-details": true,
                            ":value": "item.SoTien"
                          }
                        }
                      ]
                    }
                  }
                ],
                ":update-api": {
                  "default-item": {
                    "MaSoQD": "",
                    "MoTaQD": ""
                  },
                  "new-action": [
                    {
                      "QDID_Edit": 0,
                      "FileID_QD.FileID": "",
                      "FileID_QD.FileName": "",
                      "FileID_QD.FileUrl": "",
                      "isSelected": []
                    },
                    {
                      "CALL": "KHCN_Get"
                    }
                  ],
                  "edit-action": {
                    "QDID_Edit": "item.QDID",
                    "FileID_QD.FileID": "item.FileID",
                    "FileID_QD.FileName": "item.FileName",
                    "FileID_QD.FileUrl": "item.FileUrl"
                  },
                  "new": {
                    "CONFIRM": "Bạn có muốn thêm mới quyết định",
                    "API": "/QuyetDinh_Ins",
                    "IN": {
                      "MaSoQD": "item.MaSoQD",
                      "NgayQD": "item.NgayQD ?? 0",
                      "ThangQD": "item.ThangQD ?? 0",
                      "NamQD": "item.NamQD ?? 0",
                      "MoTaQD": "item.MoTaQD",
                      "Dot": "item.Dot",
                      "TemplateQD": 2,
                      "LoaiQD": 2,
                      "DS_FileID": "vueData.FileID_QD.FileID"
                    },
                    "OUT": "ResponseQuyetDinhIns",
                    "CALLBACK": [
                      {
                        "EXE": "showIsSelected()"
                      },
                      {
                        "EXE": "vueData.DS_FileCapKinhPhi=[]"
                      },
                      {
                        "EXE": "vueData.isSelected=[]"
                      }
                    ],
                    "MESS": "Thêm mới thành công"
                  },
                  "edit": {
                    "CONFIRM": "Bạn có muốn cập nhật quyết định",
                    "API": "/GiaiThuong_QuyetDinh_Upd",
                    "IN": {
                      "QDID": "item.QDID",
                      "MaSoQD": "item.MaSoQD",
                      "NgayQD": "item.NgayQD ?? 0",
                      "ThangQD": "item.ThangQD ?? 0",
                      "NamQD": "item.NamQD ?? 0",
                      "MoTaQD": "item.MoTaQD",
                      "DS_FileID": "vueData.FileID_QD.FileID",
                      "Dot": "item.Dot"
                    },
                    "OUT": "ResponseQuyetDinhUpd",
                    "MESS": "Cập nhật thành công",
                    "CALLBACK": {
                      "EXE": "updateTienDoObj()"
                    }
                  },
                  "delete": {
                    "CONFIRM": "Bạn có muốn xóa quyết định <b><i> {{item.MaSoQD}} </i></b>?",
                    "API": "/GiaiThuong_QuyetDinh_Del",
                    "IN": {
                      "QDID": "item.QDID"
                    },
                    "OUT": "ERRMSG",
                    "MESS": "Xóa thành công",
                    "CALLBACK": {
                      "CALL": "getQuyetDinh"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "prop": "",
          "cols": [
            {
              "el": "f-dialog",
              "attr": {
                "v-model": "DialogFile_Open",
                "title": "Thông tin quyết định",
                ":controls": [
                  {
                    "el": "div",
                    "attr": {
                      "class": "text-left black--text"
                    },
                    "innerHTML": "<p class='mb-0'><b>Quyết định:</b> <span class='red--text'>{{vueData.CT_QuyetDinh[0][0].MaSoQD === '' ? 'Chưa có' : vueData.CT_QuyetDinh[0][0].MaSoQD}}</span> <br/> <b>Ngày/Tháng/Năm:</b> <span>{{vueData.CT_QuyetDinh[0][0].NgayQD}}/{{vueData.CT_QuyetDinh[0][0].ThangQD}}/{{vueData.CT_QuyetDinh[0][0].NamQD}}</span> <br/> <b>Mô tả:</b> <span>{{vueData.CT_QuyetDinh[0][0].MoTaQD}}</span></p>"
                  },
                  {
                    "el": "div",
                    "attr": {
                      "class": "text-left"
                    },
                    "innerHTML": "<span class='title black--text'>Danh sách tập tin đính kèm</span>",
                    "w": 9
                  },
                  {
                    "el": "f-file-upload",
                    "w": 3,
                    "attr": {
                      "v-model": "vueData.DS_FileDecisionUpload",
                      "label": "Tải lên tập tin",
                      ":url": "vueData.v_Set.apiFile",
                      ":filters": "vueData.fileEX",
                      ":onclose": [
                        {
                          "EXE": "vueData.CT_QuyetDinh[1].push(vueData.DS_FileDecisionUpload.Files[0])"
                        },
                        {
                          "API": "/GiaiThuong_QuyetDinh_Upd_File",
                          "IN": {
                            "QDID": "vueData.CT_QuyetDinh[0][0].QDID",
                            "DS_FileID": "vueData.CT_QuyetDinh[1].map(item => item.FILE_ID).join(',')"
                          },
                          "MESS": "Tải tập tin thành công",
                          "CALLBACK": {
                            "DS_FileDecisionUpload": null,
                            "CALL": "getQuyetDinh"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "el": "f-table",
                    "w": 12,
                    "col": {},
                    "attr": {
                      ":excel": false,
                      ":show-search": false,
                      ":fixed-header": true,
                      ":show-select": false,
                      ":fixed-cols": 2,
                      ":mobile-breakpoint": 600,
                      ":items": "vueData.CT_QuyetDinh[1]",
                      ":headers": [
                        {
                          "text": "Tập tin",
                          "el": "span",
                          "value": "FileName",
                          "innerHTML": "<a :href='`${vueData.v_Set.urlReturnFile}/FileData/${item.FILE_ID}`' target='_blank'>{{item.FILE_NAME}}</a> ({{item.FILE_SIZE}}kb)"
                        },
                        {
                          "text": "",
                          "el": "t-button",
                          "value": "Xoa",
                          "align": "right",
                          "attr": {
                            "color": "red",
                            "label": "Xóa",
                            ":action": [
                              {
                                "FileID_Remove": "item.FILE_ID"
                              },
                              {
                                "CALL": "callApiRemoveFile"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ],
                ":button": [
                  {
                    "label": "Đóng",
                    "action": [
                      {
                        "DialogFile_Open": false
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}